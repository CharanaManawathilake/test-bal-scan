{
  "title": "--target-dir, --scan-report and --exclude-tests are ignored for single files (warnings)",
  "tags": [
    "single-file",
    "report"
  ],
  "upstream": [
    "ScanCmdTest#testScanCommandWithTargetDirFlagOnSingleFileProject",
    "ScanCmdTest#testScanCommandWithScanReportFlagOnSingleFileProject",
    "command-outputs/common/single-file-report-generation.txt"
  ],
  "steps": [
    {
      "name": "--target-dir",
      "run": "bal scan main.bal --target-dir=results"
    },
    {
      "name": "--scan-report",
      "run": "bal scan main.bal --scan-report"
    },
    {
      "name": "Both",
      "run": "bal scan main.bal --target-dir=results --scan-report"
    },
    {
      "name": "--exclude-tests",
      "run": "bal scan main.bal --exclude-tests",
      "note": "A single file has no tests; 0.13.0+ warns and scans the file."
    },
    {
      "name": "--exclude-tests=false",
      "run": "bal scan main.bal --exclude-tests=false",
      "note": "Nothing is left out, so no warning is printed."
    }
  ]
}
