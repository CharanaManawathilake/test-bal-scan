sonar.projectKey=${SONAR_PROJECT_KEY}-hello_app
sonar.projectName=${SONAR_PROJECT_KEY}-hello_app
sonar.host.url=${SONAR_HOST_URL}
sonar.token=${SONAR_TOKEN}
sonar.projectBaseDir=${WORK_DIR}/hello_app
sonar.sources=.
sonar.exclusions=**/target/**
# The work dir lives under the git-ignored results/, so SCM exclusions would hide every file
sonar.scm.exclusions.disabled=true
