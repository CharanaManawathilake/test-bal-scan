# Copy to .env and edit. Values exported in the shell override this file for a single run.

# ---------------------------------------------------------------------------
# Scan tool versions to run every case against (comma separated).
# Optional "@repo" suffix decides where `bal tool use` / `bal tool pull` looks:
#   @central (default), @local (bal tool ... --repository=local),
#   @dev (BALLERINA_DEV_CENTRAL=true), @stage (BALLERINA_STAGE_CENTRAL=true)
# Each version must be installable so that `bal tool list` shows it as the active scan version.
# e.g. SCAN_VERSIONS=0.12.0,0.13.0-SNAPSHOT@local,0.13.0@dev
SCAN_VERSIONS=0.13.0-SNAPSHOT

# Put the scan version that was active before the run back afterwards.
RESTORE_ACTIVE_VERSION=true

# The bal launcher to use.
BAL_CMD=bal

# ---------------------------------------------------------------------------
# Case selection (all optional, comma separated)
# CASES matches case ids or names with * wildcards, e.g. packages/*,single-files/rule-013*
CASES=
# Only run cases carrying one of these tags (e.g. suppression,core-rules,platform,sonarqube)
TAGS=
# Skip cases carrying one of these tags (e.g. sonarqube,network)
SKIP_TAGS=

# Kill a step that runs longer than this.
STEP_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# SonarQube (cases tagged "sonarqube" are skipped unless the URL, token and plugin path are set)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
# Platform plugin JAR (local path or URL) that `bal scan` loads for the "sonarqube" platform.
SONAR_PLATFORM_PLUGIN_PATH=C:/SonarQube/sonarqube-9.9.8.100196/extensions/platform-plugins/sonar-platform-plugin-0.3.0.jar
# Folder that holds bin/sonar-scanner; prepended to PATH for the run. Leave empty if it is already on PATH.
SONAR_SCANNER_HOME=C:/SonarQube/sonar-scanner-cli-8.1.0.6389-windows-x64
# Projects are created as <prefix>-<case>-<version>.
SONAR_PROJECT_KEY_PREFIX=bal-scan-playground

# ---------------------------------------------------------------------------
# Test plugins (tools/build-test-plugins.mjs)
# scan-command JAR to compile the test analyzers / platform plugin against. Empty = the active scan tool's JAR.
SCAN_COMMAND_JAR=
# Ballerina distribution folder (the one containing bre/lib) whose bre/lib JARs are used for compiling. Empty = detected from `bal home`.
BAL_DISTRIBUTION_HOME=

# ---------------------------------------------------------------------------
# Web UI
UI_PORT=4173
